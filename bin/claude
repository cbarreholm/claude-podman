#!/bin/bash

# GH Repo - Replace to run a fork
REPO_NAME=evancarroll/claude-podman
# Default image
IMAGE="ghcr.io/$REPO_NAME/claude-code:latest"
NAME="claudecode-$(uuidgen -r | cut -d- -f1)"
INIT_SCRIPTS=()
INIT_ENV=""
APK_PACKAGES=""
PODMAN_ARGS=""
NETWORK=""
DNS=""

# Process arguments
while [[ $# -gt 0 ]]; do
	case "$1" in
	--help)
		cat <<-'EOT'
			Usage: claude [OPTIONS]

			Run Claude Code in a Podman container

			Options:
			  --local              Use local image 'claude-code:latest' instead of remote
			  --init-script FILE   Execute initialization script as root; repeat to
			                       run several, in the order given
			  --init-env LIST      Forward these host env vars (comma or space
			                       separated names, values read from your shell)
			                       to the init scripts only, e.g. for secrets
			  --apk-packages LIST  Install additional Alpine packages (comma or space separated)
			  --network NAME       Join a dedicated podman network (created if missing) so
			                       Claude can reach other containers on it by name via DNS
			  --dns LIST           Use these DNS servers (comma or space separated, max 3)
			                       instead of the host's, so resolution survives a wifi
			                       switch, e.g. --dns 1.1.1.1,1.0.0.1. Alpine queries them
			                       in parallel and takes the first answer, so list one per
			                       network you use, and only servers that agree.
			  --podman-arg ARG     Pass additional argument to podman
			  --version            Show the Claude Code version in the image
			  --help               Display this help message
		EOT
		exit 0
		;;
	--self-update)
		curl --proto '=https' --tlsv1.2 -sSf \
			"https://raw.githubusercontent.com/$REPO_NAME/refs/heads/main/bin/claude" |
			sed "s|^REPO_NAME=.*|REPO_NAME=$REPO_NAME|" |
			sudo tee /usr/local/bin/claude-podman >/dev/null
		sudo chmod a+x /usr/local/bin/claude-podman
		echo "Updated"
		exit 0
		;;
	--local)
		IMAGE="localhost/claude-code:latest"
		shift
		;;
	--init-script)
		INIT_SCRIPTS+=("$2")
		shift 2
		;;
	--init-env)
		INIT_ENV="$2"
		shift 2
		;;
	--apk-packages)
		APK_PACKAGES="$2"
		shift 2
		;;
	--network)
		NETWORK="$2"
		shift 2
		;;
	--dns)
		DNS="$2"
		shift 2
		;;
	--podman-arg)
		PODMAN_ARGS="$PODMAN_ARGS $2"
		shift 2
		;;
	--version)
		podman run \
			--rm \
			--user claude \
			--userns=keep-id:uid=1000,gid=1000 \
			$PODMAN_ARGS \
			"$IMAGE" --version
		exit 0
		;;
	*)
		break
		;;
	esac
done

# Podman snapshots the host's resolvers into the container at startup and never
# refreshes them, so switching wifi leaves the session resolving against DNS
# servers that are no longer reachable. Naming the servers explicitly keeps
# resolution working across the switch.
DNS_ARGS=""
if [ -n "$DNS" ]; then
	for SERVER in $(echo "$DNS" | tr -s ', ' ' '); do
		DNS_ARGS="$DNS_ARGS --dns=$SERVER"
	done
fi

# Join a dedicated network, creating it if it doesn't exist yet
NETWORK_ARG=""
if [ -n "$NETWORK" ]; then
	if ! podman network exists "$NETWORK"; then
		podman network create "$NETWORK"
	fi
	NETWORK_ARG="--network $NETWORK"
fi

# Setup failures must not leave you in a session that silently lacks
# whatever the setup was supposed to provide: tear the container down
# and surface the error instead of attaching.
abort() {
	echo "$1" >&2
	podman stop --time 0 "$NAME" >/dev/null 2>&1
	exit 1
}

# --init puts a minimal init (catatonit) at PID 1 so orphaned children of
# Claude's tool calls are reaped. Without it claude is PID 1, nothing reaps,
# and zombies pile up until the container hits its pids limit and every
# fork fails with "resource temporarily unavailable".
if ! podman run \
	--init \
	-v "${HOME}/.claude:/home/claude/.claude" \
	-v "${HOME}/.claude.json:/home/claude/.claude.json" \
	-v "${PWD}:${PWD}" \
	-w "$PWD" \
	--rm \
	--name "$NAME" \
	-ti \
	--detach \
	--user claude \
	--userns=keep-id:uid=1000,gid=1000 \
	$NETWORK_ARG \
	$DNS_ARGS \
	$PODMAN_ARGS \
	"$IMAGE" "$@"; then
	echo "failed to start container" >&2
	exit 1
fi

if [ -n "$APK_PACKAGES" ]; then
	APK_PACKAGES=$(echo $APK_PACKAGES | tr -s ', ' ' ')
	podman exec --user root:root "$NAME" /bin/bash -c "apk update; apk add $APK_PACKAGES" ||
		abort "--apk-packages failed; not starting the session"
fi
if [ ${#INIT_SCRIPTS[@]} -gt 0 ]; then
	# Forward named host env vars to the init scripts. The bare "-e VAR"
	# form makes podman read the value from this shell's environment, so
	# the secret never appears in argv (host `ps`) and — because this is
	# exec rather than run — never lands in `podman inspect` either.
	INIT_ENV_ARGS=""
	if [ -n "$INIT_ENV" ]; then
		for VAR in $(echo "$INIT_ENV" | tr -s ', ' ' '); do
			if [ -z "${!VAR:-}" ]; then
				abort "--init-env $VAR is unset or empty in the environment"
			fi
			INIT_ENV_ARGS="$INIT_ENV_ARGS -e $VAR"
		done
	fi
	# Run in the order given, stopping at the first failure so later
	# scripts never build on a half-finished setup.
	for I in "${!INIT_SCRIPTS[@]}"; do
		SCRIPT="${INIT_SCRIPTS[$I]}"
		podman cp "$SCRIPT" "$NAME:/root/init-$I.sh" ||
			abort "failed to copy init script $SCRIPT into the container"
		podman exec --user root:root $INIT_ENV_ARGS "$NAME" bash "/root/init-$I.sh" ||
			abort "init script $SCRIPT failed; not starting the session"
	done
fi

podman container attach "$NAME"
