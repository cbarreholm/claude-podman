#!/bin/bash

# GH Repo - Replace to run a fork
REPO_NAME=evancarroll/claude-podman
# Default image
IMAGE="ghcr.io/$REPO_NAME/claude-code:latest"
NAME="claudecode-$(uuidgen -r | cut -d- -f1)"
INIT_SCRIPT=""
APK_PACKAGES=""
PODMAN_ARGS=""
RESTRICTED_NETWORK=""
SQUID_IMAGE="ghcr.io/$REPO_NAME/claude-squid:latest"

# Process arguments
while [[ $# -gt 0 ]]; do
	case "$1" in
	--help)
		cat <<-'EOT'
			Usage: claude [OPTIONS]

			Run Claude Code in a Podman container

			Options:
			  --local              Use local image 'claude-code:latest' instead of remote
			  --init-script FILE   Execute initialization script
			  --apk-packages LIST  Install additional Alpine packages (comma or space separated)
			  --podman-arg ARG     Pass additional argument to podman
			  --restricted-network Run with network restricted to Anthropic API endpoints only, using squid proxy
			  --version            Show the Claude Code version in the image
			  --help               Display this help message
		EOT
		exit 0
		;;
	--self-update)
		curl --proto '=https' --tlsv1.2 -sSf \
			"https://raw.githubusercontent.com/$REPO_NAME/refs/heads/main/bin/claude" |
			sed "s|^REPO_NAME=.*|REPO_NAME=$REPO_NAME|" |
			sudo tee /usr/local/bin/claude-podman >/dev/null
		sudo chmod a+x /usr/local/bin/claude-podman
		echo "Updated"
		exit 0
		;;
	--local)
		IMAGE="localhost/claude-code:latest"
		SQUID_IMAGE="localhost/claude-squid:latest"
		shift
		;;
	--init-script)
		INIT_SCRIPT="$2"
		shift 2
		;;
	--apk-packages)
		APK_PACKAGES="$2"
		shift 2
		;;
	--podman-arg)
		PODMAN_ARGS="$PODMAN_ARGS $2"
		shift 2
		;;
	--restricted-network)
		RESTRICTED_NETWORK=1
		shift
		;;
	--version)
		podman run \
			--rm \
			--user claude \
			--userns=keep-id:uid=1001,gid=1001 \
			$PODMAN_ARGS \
			"$IMAGE" --version
		exit 0
		;;
	*)
		break
		;;
	esac
done

# Set up restricted network if requested
if [ -n "$RESTRICTED_NETWORK" ]; then
	SQUID_NAME="claude-squid-$(uuidgen -r | cut -d- -f1)"
	NETWORK_NAME="claude-restricted-net"

	# Create internal network (no external access) if it doesn't exist
	if ! podman network exists "$NETWORK_NAME" 2>/dev/null; then
		podman network create --internal "$NETWORK_NAME"
	fi

	# Start Squid proxy on both the internal and default networks
	# so it can relay traffic from the isolated Claude container to the internet
	podman run \
		--rm \
		--name "$SQUID_NAME" \
		--network "$NETWORK_NAME" \
		--network podman \
		--detach \
		"$SQUID_IMAGE"

	# Add network and proxy env vars to Claude container args
	PODMAN_ARGS="$PODMAN_ARGS --network=$NETWORK_NAME"
	PODMAN_ARGS="$PODMAN_ARGS -e HTTPS_PROXY=http://${SQUID_NAME}:3128"
	PODMAN_ARGS="$PODMAN_ARGS -e HTTP_PROXY=http://${SQUID_NAME}:3128"

	# Cleanup trap: stop squid and remove network on exit
	cleanup_restricted_network() {
		podman stop "$SQUID_NAME" 2>/dev/null
		podman network rm "$NETWORK_NAME" 2>/dev/null
	}
	trap cleanup_restricted_network EXIT
fi

echo "$NAME" >&2

podman run \
	-v "${HOME}/.claude:/home/claude/.claude" \
	-v "${HOME}/.claude.json:/home/claude/.claude.json" \
	-v "${PWD}:${PWD}" \
	-w "$PWD" \
	--rm \
	--name "$NAME" \
	-ti \
	--detach \
	--user claude \
	--userns=keep-id:uid=1000,gid=1000 \
	$PODMAN_ARGS \
	"$IMAGE" "$@"

if [ -n "$APK_PACKAGES" ]; then
	APK_PACKAGES=$(echo $APK_PACKAGES | tr -s ', ' ' ')
	podman exec --user root:root "$NAME" /bin/bash -c "apk update; apk add $APK_PACKAGES"
fi
if [ -n "$INIT_SCRIPT" ]; then
	podman cp "$INIT_SCRIPT" "$NAME:/root/init.sh"
	podman exec --user root:root "$NAME" bash /root/init.sh
fi

podman container attach "$NAME"